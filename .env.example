# Copy to .env and fill in from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# Only EXPO_PUBLIC_* vars reach the app bundle. Never put the service_role key
# here — it bypasses every RLS policy and would ship inside the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: lets the sign-in screen show a one-tap "demo account" button so the
# demo never depends on an email arriving. Matches the first seeded user in
# supabase/seed.sql. Leave blank to hide the button.
EXPO_PUBLIC_DEMO_EMAIL=
EXPO_PUBLIC_DEMO_PASSWORD=
