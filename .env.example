# Copy to .env (gitignored). Only EXPO_PUBLIC_* vars reach the app bundle, and
# all of them are public by design: real secrets live in server/.env.

# The API server. Leave blank in development: the app finds the computer that
# runs Expo on port 8787 automatically. For the deployed server:
#   EXPO_PUBLIC_API_URL=https://api.<our-domain>
EXPO_PUBLIC_API_URL=

# Auth0 (Applications → FirstPlace → Settings, and APIs → FirstPlace API → Identifier)
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=

# Shows a one-tap "demo account" button (the server's dev login must be on).
EXPO_PUBLIC_DEMO_EMAIL=demo@thirdplace.test
