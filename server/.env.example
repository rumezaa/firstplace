# FirstPlace API server. Copy to server/.env (gitignored). Never commit real values.

# Local: docker run -d --name firstplace-db -e POSTGRES_PASSWORD=localdev -p 54330:5432 timescale/timescaledb:latest-pg17
# Tiger Cloud: paste the service connection string (it includes ?sslmode=require).
DATABASE_URL=postgres://postgres:localdev@localhost:54330/postgres

PORT=8787

# Auth0 (Applications → APIs → your API's identifier is the audience).
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Dev login (POST /dev/login as a seeded user). Defaults to on outside production.
DEV_LOGIN=true
DEV_TOKEN_SECRET=change-me-to-a-long-random-string

GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-flash-latest

# Chat-table lights: comma-separated keys, one per ESP32.
HW_DEVICE_KEYS=

# Comma-separated allowed origins, or * for the hackathon.
CORS_ORIGINS=*
