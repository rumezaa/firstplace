# FirstPlace API server. Copy to server/.env (gitignored). Never commit real values.

# Local: docker run -d --name firstplace-db -e POSTGRES_PASSWORD=localdev -p 54330:5432 timescale/timescaledb:latest-pg17
# Tiger Cloud: paste the service connection string (it includes ?sslmode=require).
DATABASE_URL=postgres://postgres:localdev@localhost:54330/postgres

PORT=8787

# Auth0 (Applications → APIs → your API's identifier is the audience).
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Dev login (POST /dev/login as a seeded user). Defaults to on outside production.
DEV_LOGIN=true
DEV_TOKEN_SECRET=change-me-to-a-long-random-string

GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# Guard rails (defaults shown). Cache hits are free and never counted.
# Timeout is per model attempt; the deadline covers all fallback models together.
GEMINI_TIMEOUT_MS=8000
GEMINI_DEADLINE_MS=15000
# Per signed-in user (per IP when signed out), and for the whole server.
GEMINI_USER_PER_MINUTE=6
GEMINI_USER_PER_DAY=60
GEMINI_GLOBAL_PER_MINUTE=30
GEMINI_MAX_CONCURRENT=4

# Chat-table lights: comma-separated keys, one per ESP32.
HW_DEVICE_KEYS=

# Comma-separated allowed origins, or * for the hackathon.
CORS_ORIGINS=*

# Where tag links (/t/<tableId>, /v/<venueId>) forward to. Change this, never the stickers.
# Dev build:  firstplace://
# Expo Go:    exp://<your-laptop-ip>:8081/--/
APP_LINK_BASE=exp://192.168.1.42:8081/--/
# Optional: the deployed Expo web build. When set, tag pages also show "Open on the web".
WEB_APP_URL=
